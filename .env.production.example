# Шаблон прод-окружения. На сервере:
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml \
#     run --rm artisan key:generate --show      # значение вписать в APP_KEY ниже
#
# Файл читают двое: контейнеры (env_file) и сам Compose — из него подставляются
# ${DB_USERNAME}, ${DB_PASSWORD}, ${DB_DATABASE} и ${REDIS_PASSWORD} в db и redis.
# В git он не едет (.gitignore) и в образ не попадает (.dockerignore).

APP_NAME="ARÔME Admin"
APP_ENV=production
APP_DEBUG=false

# Обязательно свой, не скопированный из dev: этим ключом шифруются сессии и
# токены. Пустой APP_KEY роняет приложение на первом же запросе.
APP_KEY=

# Адрес, по которому панель открывается снаружи, вместе со схемой. Отсюда
# берутся ссылки в письмах и абсолютные URL — localhost здесь ломает их молча.
APP_URL=https://example.com

# Каталога lang/ в проекте нет — тексты панели живут в Vue-компонентах, а
# сообщения валидации берутся из фреймворка. Локаль оставлена как в dev, чтобы
# прод не отличался поведением.
APP_TIMEZONE=Asia/Ashgabat
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Логи уходят в stderr контейнера, ротацией занимается docker (json-file,
# 10 МБ × 3 в docker-compose.prod.yml) — файл в storage/logs не растёт.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=aroma
DB_USERNAME=aroma
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Сессии и кэш живут в Postgres (таблицы sessions и cache заводит миграция).
# Redis поднят под них же — переключение стоит смены двух строк на redis.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_LIFETIME=120

# Включать только когда перед nginx стоит TLS-терминатор и APP_URL на https:
# с secure-кукой поверх голого http вход не работает вообще.
# SESSION_SECURE_COOKIE=true

# Главный администратор панели: единственная учётка с разделом «Пользователи».
# Заводится сидером при старте контейнера, пароль освежается из этого файла при
# каждом рестарте — менять его здесь, а не в панели.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_NAME="Администратор"

# Служебный вход в консоль /su. Учётка не создаётся сама — только командой
# `... run --rm artisan aroma:superadmin`.
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME="Суперадмин"

# Дамп базы 1-го и 16-го числа в 03:00 (`php artisan db:backup`). Файлы лежат в
# storage/app/backups, то есть в томе storage_data, и переживают пересоздание
# контейнеров. KEEP — сколько последних копий держать.
BACKUP_KEEP=10
BACKUP_TIMEOUT=900
