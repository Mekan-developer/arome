APP_NAME="ARÔME Admin"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://arome-tm.com
APP_TIMEZONE=Asia/Ashgabat
APP_LOCALE=en
APP_FALLBACK_LOCALE=en


LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=aroma
DB_USERNAME=aroma
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_LIFETIME=120

# Сейчас сайт работает по голому http, поэтому строка закомментирована: с
# secure-кукой поверх http вход не работает вообще. Включать вместе с переводом
# APP_URL на https, когда перед nginx встанет TLS-терминатор.
# SESSION_SECURE_COOKIE=true

# Главный администратор панели: единственная учётка с разделом «Пользователи».
# Заводится сидером при старте контейнера, пароль освежается из этого файла при
# каждом рестарте — менять его здесь, а не в панели.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_NAME="Администратор"

# Служебный вход в консоль /su. Учётка не создаётся сама — только командой
# `... run --rm artisan aroma:superadmin`.
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME="Суперадмин"

# Дамп базы 1-го и 16-го числа в 03:00 (`php artisan db:backup`). Файлы лежат в
# storage/app/backups, то есть в томе storage_data, и переживают пересоздание
# контейнеров. KEEP — сколько последних копий держать.
BACKUP_KEEP=10
BACKUP_TIMEOUT=900
