meta {
  name: Sync device
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/sync
  body: json
  auth: inherit
}

body:json {
  {
    "data_version": {{data_version}},
    "app_version": "1.4.2"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("data_version", res.body.data.catalog_version);
  }
}

assert {
  res.status: eq 200
  res.body.data.catalog_version: isDefined
  res.body.data.up_to_date: isDefined
}

tests {
  test("отставание — это разница ревизий", function () {
    const data = res.getBody().data;

    expect(data.lag).to.equal(Math.max(0, data.catalog_version - data.previous_version));
    expect(data.up_to_date).to.equal(data.lag === 0);
  });
}

docs {
  Устройство сообщает, какую ревизию каталога оно применило, и узнаёт, насколько отстало.
  По этой цифре раздел «Синхронизация» в панели красит строки: 0 — зелёная, до 100 — жёлтая,
  дальше — красная.

  Сервер при этом отмечает устройство синхронизированным (`synced_at`, `data_version`, `lag`),
  а если отставание было — пишет строку в журнал.

  Запрос обновляет переменную `data_version`, как это делает реальное устройство после
  применения ревизии.

  Три вещи, которые видно по ответу и стоит знать:

  - Дельту каталога эндпоинт **не отдаёт** — только номера ревизий. Сами товары устройство
    тянет через `GET /products`.
  - `catalog_version` сейчас берётся из `config('aroma.catalog_version')`, то есть это
    константа, а не производная от данных: импорт прайса её не двигает.
  - `app_version` принимается и валидируется, но никуда не сохраняется, хотя колонка
    `app_version` в таблице `devices` есть.

  Ещё один ответ, до которого этой коллекцией не дотянуться: 403 `device_blocked`. Он
  требует живого токена при `devices.is_blocked = true`, а блокировка сотрудника в панели
  удаляет токены в той же транзакции, в которой поднимает флаг. Воспроизводится только
  правкой флага в базе.
}
