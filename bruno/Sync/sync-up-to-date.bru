meta {
  name: Sync device — up to date
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/sync
  body: json
  auth: inherit
}

body:json {
  {
    "data_version": {{data_version}},
    "app_version": "1.4.2"
  }
}

assert {
  res.status: eq 200
  res.body.data.lag: eq 0
  res.body.data.up_to_date: eq true
}

docs {
  Устройство на актуальной ревизии: `lag` 0, `up_to_date` true, качать нечего.

  Работает поверх переменной `data_version`, которую заполнил запрос `Sync device`, поэтому
  прогонять папку нужно по порядку. При запуске в одиночку с пустым окружением сюда уйдёт
  0 и проверка справедливо упадёт — сначала выполните `Sync device`.
}
