meta {
  name: List products — no token
  type: http
  seq: 7
}

get {
  url: {{base_url}}/api/v1/products
  body: none
  auth: none
}

assert {
  res.status: eq 401
}

tests {
  test("каталог не отдаётся без токена", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.not.have.property("data");
  });
}

docs {
  Каталог не публичный. Дело не только в закрытости прайса: состав полей решает матрица
  прав роли, а она бессмысленна, пока сервер не знает, кто спрашивает.

  У запроса намеренно снята авторизация коллекции (`auth: none`) — bearer-заголовок
  не подставляется, даже когда переменная `token` заполнена.
}
