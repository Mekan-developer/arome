meta {
  name: List products — search, status, sort
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/products?q=versace&status=active&sort=-price&per_page=10
  body: none
  auth: inherit
}

params:query {
  q: versace
  status: active
  sort: -price
  per_page: 10
  ~point: 1
}

assert {
  res.status: eq 200
  res.body.meta.per_page: eq 10
}

tests {
  test("фильтр по статусу не пропускает скрытые товары", function () {
    res.getBody().data.forEach(function (row) {
      expect(row.status).to.equal("active");
    });
  });

  test("сортировка по убыванию цены соблюдена", function () {
    const prices = res.getBody().data
      .filter(function (row) { return row.retail !== undefined; })
      .map(function (row) { return row.retail.amount; });

    for (let i = 1; i < prices.length; i++) {
      expect(prices[i]).to.be.at.most(prices[i - 1]);
    }
  });
}

docs {
  Поиск идёт по номенклатуре, артикулу, основному коду и штрихкоду, но включается только
  с двух символов — односимвольный `q` молча игнорируется, чтобы не тянуть весь прайс.

  `sort` понимает `name`, `sku`, `price`, минус впереди даёт убывание. Всё остальное —
  включая попытку подставить выражение в ORDER BY — падает в сортировку по имени: колонки
  берутся из белого списка `ProductRepository::SORTABLE`.

  Неизвестный `status` тоже игнорируется, а не даёт 422: живому приложению в зале полезнее
  получить список, чем ошибку валидации.

  Параметр `point` выключен намеренно. Он работает, только когда включён модуль
  `productPoints` и роли открыт `stock` — иначе фильтр молча не применяется. Значение —
  это `id` точки.
}
