meta {
  name: Product by barcode — malformed
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/v1/products/not-a-barcode
  body: none
  auth: inherit
}

assert {
  res.status: eq 404
}

tests {
  test("ошибка приходит как JSON, а не как HTML-страница", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
  });

  test("до контроллера запрос не дошёл", function () {
    expect(res.getBody()).to.not.have.nested.property("error.code");
  });
}

docs {
  Штрихкод ограничен на уровне маршрута: `[0-9]{8,13}`. Мусор со сканера не доходит до
  контроллера и до базы — маршрут просто не совпадает.

  Проверка стоит на том, что ответ всё равно JSON: `bootstrap/app.php` включает
  `shouldRenderJsonWhen` для всего `api/*`, иначе телефон получил бы HTML-страницу ошибки
  и споткнулся бы на разборе.
}
