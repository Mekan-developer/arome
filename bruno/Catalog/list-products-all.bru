meta {
  name: All products — full dump
  type: http
  seq: 10
}

get {
  url: {{base_url}}/api/v1/products_all
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.meta.server_time: isDefined
  res.body.meta.has_more: isUndefined
}

tests {
  /*
   * Проверки идут одним `expect` на весь список, а не по `expect` на строку: в выгрузке
   * десятки тысяч позиций, и chai-объект на каждую кладёт песочницу Bruno.
   */
  test("скрытых товаров в выгрузке нет", function () {
    const hidden = res.getBody().data.find(function (row) {
      return row.status !== "active";
    });

    expect(hidden).to.be.undefined;
  });

  test("выгрузка не короче первой страницы каталога", function () {
    expect(res.getBody().data.length).to.be.at.least(1);
  });
}

docs {
  Весь каталог одним ответом: ни поиска, ни фильтров, ни постраничности. Этим приложение
  заливает свою локальную базу целиком, а дальше живёт на `products` и `products/{barcode}`.

  Параметры списка (`q`, `status`, `sort`, `per_page`, `page`) здесь не читаются вообще —
  добавить их в адрес можно, на ответ это не влияет.

  Два ограничения фильтрами не являются и потому в силе и здесь: скрытый товар на устройство
  не уходит, а состав колонок в строке по-прежнему определяет матрица прав роли.

  Ответ отдаётся потоком и читается из базы пачками по тысяче строк, поэтому прайс на
  десятки тысяч позиций не собирается в памяти целиком. `meta` приходит в конце тела —
  клиенту, который разбирает ответ по мере получения, `data` доступна раньше.
}
