meta {
  name: Product by barcode
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/v1/products/{{barcode}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.data.id: isDefined
  res.body.data.status: isDefined
  res.body.meta.server_time: isDefined
}

tests {
  test("если скидка видна, цена со скидкой посчитана на сервере", function () {
    const product = res.getBody().data;

    if (product.discount === undefined) {
      return;
    }

    expect(product.final, "поле final приходит вместе с discount").to.be.an("object");
    expect(product.final.currency).to.equal("TMT");

    if (product.retail !== undefined) {
      expect(product.final.amount).to.be.at.most(product.retail.amount);
    }
  });
}

docs {
  То, ради чего продавец подносит сканер: точное совпадение по индексированной колонке.

  `final` (цена со скидкой) считается на сервере и приезжает в паре с `discount` — телефон
  не перемножает проценты сам, иначе на витрине и в чеке разошлись бы копейки.

  Штрихкод берётся из переменной `barcode`; запрос `List products` обновляет её автоматически.
}
