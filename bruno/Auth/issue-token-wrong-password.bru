meta {
  name: Issue token — wrong password
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/tokens
  body: json
  auth: none
}

body:json {
  {
    "login": "{{login}}",
    "password": "definitely-not-the-password",
    "device": "{{device}}"
  }
}

assert {
  res.status: eq 401
  res.body.error.code: eq invalid_credentials
}

tests {
  test("ответ не подсказывает, существует ли логин", function () {
    expect(res.body.error.code).to.equal("invalid_credentials");
    expect(res.body).to.not.have.property("data");
  });
}

docs {
  Неверный пароль и несуществующий логин дают один и тот же `invalid_credentials` / 401 —
  по ответу нельзя перебором выяснить, какие логины заведены.

  Отдельный код `account_blocked` (403) существует только для случая, когда пара логин+пароль
  верна: сотруднику нужно понимать, что дело не в опечатке.
}
