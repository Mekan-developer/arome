APP_NAME="ARÔME Admin"
APP_ENV=local
APP_KEY=base64:USvWh6kf91iLNwkncmhfb3sOrxsJCk/TOYaEQ4EUmaE=
APP_DEBUG=true
APP_URL=https://arome-tm.com
APP_TIMEZONE=asia/ashgabat

APP_LOCALE=tm
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=10

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=aroma_db
DB_USERNAME=admin
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=32e3c54df6e5af846099fbec0dbaa15194af34777fccf3203caf58d6e92c91d8
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
COMPOSE_PROJECT_NAME=aroma

# Служебный вход в консоль /su. Учётка создаётся командой `php artisan aroma:superadmin`.
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=secret
SUPERADMIN_NAME="Суперадмин"

# Первый администратор панели. Учётка создаётся командой `php artisan db:seed`.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345
ADMIN_NAME="Администратор"


UID=1000

# Зеркала для сборки образа (build-args, в рантайме не используются).
# Вместо dl-cdn.alpinelinux.org
ALPINE_MIRROR=https://mirror.yandex.ru/mirrors/alpine
# Вместо repo.packagist.org
COMPOSER_MIRROR=https://nexus.telecom.tm/repository/composer-proxy/
# Вместо registry.npmjs.org
NPM_REGISTRY=https://nexus.telecom.tm/repository/npm-proxy/
